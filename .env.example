# LLM provider: "anthropic" or "openai" (any OpenAI-compatible endpoint, e.g. Ollama)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# For anthropic, leave empty to use ANTHROPIC_API_KEY / an `ant auth login` profile
LLM_API_KEY=
# Only for openai-compatible endpoints, e.g. http://localhost:11434/v1 for Ollama
LLM_BASE_URL=

# Transit data (MOTIS API)
TRANSIT_BASE_URL=https://api.transitous.org
TRANSIT_USER_AGENT=dticket-planner/0.1 (set a contact address here)

# Local embedding model (fastembed)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
